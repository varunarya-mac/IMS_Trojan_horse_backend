{
  "name": "ims_trojan_horse_backend",
  "version": "1.0.0",
  "description": "IoT Alarm Flow Management Backend for TESCO",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "dev": "ts-node --esm src/index.ts",
    "start": "node dist/index.js",
    "setup-db": "ts-node --esm scripts/setup-database.ts",
    "setup-refrigeration-db": "ts-node --esm scripts/setup-refrigeration-db.ts",
    "seed": "ts-node --esm scripts/seed-data.ts",
    "build:fn-chat-api": "cd functions/fn-chat-api && npm run build",
    "build:fn-csv-handler": "cd functions/fn-csv-handler && npm run build",
    "build:fn-analysis-engine": "cd functions/fn-analysis-engine && npm run build",
    "build:fn-job-worker": "cd functions/fn-job-worker && npm run build",
    "build:functions": "npm run build:fn-chat-api && npm run build:fn-csv-handler && npm run build:fn-analysis-engine && npm run build:fn-job-worker",
    "install:functions": "cd functions/fn-chat-api && npm install && cd ../fn-csv-handler && npm install && cd ../fn-analysis-engine && npm install && cd ../fn-job-worker && npm install",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.2.3",
    "node-appwrite": "^21.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^25.0.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3"
  }
}
