{
  "name": "ims_trojan_horse_backend",
  "version": "1.0.0",
  "description": "IoT Alarm Flow Management Backend for TESCO",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run build:functions",
    "build:lib": "cd lib && npm run build",
    "dev": "ts-node --esm src/index.ts",
    "start": "node dist/index.js",
    "setup-db": "ts-node --esm scripts/setup-database.ts",
    "setup-refrigeration-db": "ts-node --esm scripts/setup-refrigeration-db.ts",
    "setup-chromadb": "ts-node --esm scripts/setup-chromadb.ts",
    "seed": "ts-node --esm scripts/seed-data.ts",
    "build:fn-alarm-management": "cd functions/fn-alarm-management && npm run build",
    "build:fn-chat-api": "cd functions/fn-chat-api && npm run build",
    "build:fn-chat-processor": "cd functions/fn-chat-processor && npm run build",
    "build:fn-vector-search": "cd functions/fn-vector-search && npm run build",
    "build:fn-job-worker": "cd functions/fn-job-worker && npm run build",
    "build:functions": "npm run build:fn-alarm-management && npm run build:fn-chat-api && npm run build:fn-chat-processor && npm run build:fn-vector-search && npm run build:fn-job-worker",
    "install:functions": "cd functions/fn-alarm-management && npm install && cd ../fn-chat-api && npm install && cd ../fn-chat-processor && npm install && cd ../fn-vector-search && npm install && cd ../fn-job-worker && npm install",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.2.3",
    "node-appwrite": "^21.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^25.0.1",
    "chromadb": "^2.0.0",
    "mammoth": "^1.9.0",
    "openai": "^4.77.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3"
  }
}
