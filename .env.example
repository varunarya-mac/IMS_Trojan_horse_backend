# Appwrite Configuration
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id
APPWRITE_API_KEY=your_appwrite_api_key
APPWRITE_DATABASE_ID=iot_alarm_management

# Environment
NODE_ENV=development

# OpenAI Configuration (for IoT Refrigeration Chat)
OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_MODEL=gpt-4o
OPENAI_GUARDRAIL_MODEL=gpt-4o-mini

# Storage Bucket (single bucket for all refrigeration files)
REFRIGERATION_BUCKET_ID=refrigeration-files

# ChromaDB Cloud Configuration
CHROMADB_TENANT=your_chromadb_tenant_id
CHROMADB_API_KEY=your_chromadb_api_key
CHROMADB_DATABASE=your_chromadb_database_name

# Function IDs (set after deploying functions)
FN_CHAT_PROCESSOR_ID=fn-chat-processor
FN_VECTOR_SEARCH_ID=fn-vector-search

# Context Settings
CONTEXT_MESSAGE_COUNT=3
CONTEXT_EXPIRY_HOURS=24

# Cleanup Worker Configuration
CHAT_ARCHIVE_AGE_DAYS=30
